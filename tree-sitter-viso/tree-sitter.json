{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "viso",
      "camelcase": "Viso",
      "scope": "source.viso",
      "path": ".",
      "file-types": [
        "vs"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^viso$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Viso grammar for tree-sitter"
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}